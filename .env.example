APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_ALLOWED_ORIGIN=*
COLLECTION_PREFIX=DCR-0
AUTH_SECRET=change-this-secret
AUTH_TOKEN_TTL_SECONDS=28800

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=topnotch_migrate
DB_USER=root
DB_PASS=

# Optional MySQL admin used only for corporate dump staging (CREATE/DROP temporary DB).
# CORPORATE_IMPORT_MYSQL_USER=root
# CORPORATE_IMPORT_MYSQL_PASS=

# Optional comma-separated parent dirs of mounted Backup Destinations (in addition to /Volumes, /media, /mnt).
# BACKUP_DESTINATION_ROOTS=/data/drives
# Optional override for mysqldump binary.
# MYSQLDUMP_PATH=/usr/bin/mysqldump
# Optional override for mysql client binary.
# MYSQL_PATH=/usr/bin/mysql
